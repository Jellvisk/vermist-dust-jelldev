<controls:FancyWindow xmlns="https://spacestation14.io"
                xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                xmlns:vds="clr-namespace:Content.Client._VDS.UserInterface.Controls"
                Title="{Loc 'pulveris-barrier-controller-ui-title'}"

                Resizable="True">
    <GridContainer Columns="2">
        <BoxContainer VerticalExpand="True"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Margin="0 10">
            <Button Name="ToggleButton"
                    Text="test"></Button>
        </BoxContainer>
        <BoxContainer VerticalExpand="True"
                      HorizontalExpand="True"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Margin="0 10">
            <vds:SimpleVectorCanvas Name="Testy">
                <vds:SimpleVectorCanvas.Vectors>
                    <vds:SimpleVectorCanvasPoint Position="100 200"/>
                    <vds:SimpleVectorCanvasPoint Position="120 120"/>
                    <vds:SimpleVectorCanvasPoint Position="130 120"/>
                    <vds:SimpleVectorCanvasLine From="100 140" To="330 300" Steps="2" BrushKey="epic"/>
                    <vds:SimpleVectorCanvasPoint Position="200 300" BrushKey="cool"/>
                </vds:SimpleVectorCanvas.Vectors>
                <vds:SimpleVectorCanvas.Brushes>
                    <vds:Circle Key="cool" Color="Red" Radius="50" Filled="False"/>
                    <vds:Circle Key="epic" Color="Blue" Radius="5" Filled="True"/>
                </vds:SimpleVectorCanvas.Brushes>
            </vds:SimpleVectorCanvas>
        </BoxContainer>
    </GridContainer>
</controls:FancyWindow>
