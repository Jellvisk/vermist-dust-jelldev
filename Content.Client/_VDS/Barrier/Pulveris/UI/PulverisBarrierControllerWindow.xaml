<controls:FancyWindow xmlns="https://spacestation14.io"
                xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                xmlns:vds="clr-namespace:Content.Client._VDS.UserInterface.Controls"
                Title="{Loc 'pulveris-barrier-controller-ui-title'}"

                Resizable="False">
    <GridContainer Columns="2">
        <BoxContainer VerticalExpand="True"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Margin="0 10">
            <Button Name="ToggleButton"
                    Text="test"></Button>
        </BoxContainer>
        <vds:SimpleVectorCanvas Name="Testy">
            <vds:SimpleVectorCanvas.Points>
                <vds:SimpleCanvasPoint Key="origin" Location="100 0" Radius="4" />
                <vds:SimpleCanvasPoint Key="corner" Location="120 120" Radius="2"/>
            </vds:SimpleVectorCanvas.Points>
            <vds:SimpleVectorCanvas.Lines>
                <vds:SimpleCanvasLine Key="bitch" From="420 320" To="-300 10" Width="2"/>
            </vds:SimpleVectorCanvas.Lines>
        </vds:SimpleVectorCanvas>
    </GridContainer>
</controls:FancyWindow>
